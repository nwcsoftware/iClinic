# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Resend (staff OTP emails) — optional for local dev
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Anthropic (AI triage chat). If unset, a built-in classifier is used.
ANTHROPIC_API_KEY=

# Admin key for /api/admin/subscription (Bearer). Generate a strong random value.
ADMIN_API_KEY=

# Local payment details shown to doctors on the paywall
PAY_WHISH_NUMBER=
PAY_OMT_NAME=
PAY_BANK_DETAILS=
PAY_CONTACT=
PAY_NOTE=

# Hosted card checkout URL, once a provider is set up
BILLING_CHECKOUT_URL=

# ---------------------------------------------------------------------------
# Areeba card payments (Mastercard Payment Gateway Services).
# Get these from Areeba merchant onboarding. A TEST merchant id is prefixed
# "TEST", e.g. TEST799700711 — the app shows a test-mode banner when it sees one.
# ---------------------------------------------------------------------------
AREEBA_MERCHANT_ID=
AREEBA_API_PASSWORD=
AREEBA_BASE_URL=https://epayment.areeba.com
AREEBA_API_VERSION=100

# Absolute URL of THIS app, used to build the payment return URL.
# Falls back to the incoming request origin when unset.
PUBLIC_WEB_URL=

# Dev only: exercise the full payment flow without Areeba credentials.
# Ignored when NODE_ENV=production, so it can never run live.
AREEBA_SIMULATE=
