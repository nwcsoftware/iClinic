{
  "expo": {
    "name": "iClinic",
    "slug": "iclinic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.iclinic.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "iClinic uses your location to show where you are on the map of hospitals and clinics, and to place a clinic pin when a doctor adds a workplace."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon-1024.png",
        "backgroundColor": "#3056D3"
      },
      "predictiveBackGestureEnabled": false,
      "package": "health.iclinic.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icons/icon-192.png",
      "name": "iClinic",
      "shortName": "iClinic",
      "themeColor": "#3056D3",
      "backgroundColor": "#3056D3",
      "display": "standalone"
    },
    "scheme": "iclinic",
    "primaryColor": "#3056D3",
    "plugins": [
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "144f78d7-108c-405d-8c3a-af5e10e089a5"
      }
    },
    "owner": "jadchami"
  }
}
